{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": [
      "react",
      "react-dom"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "scripts/*.ts",
    "vite.config.ts",
    "../shared/src"
  ]
}
